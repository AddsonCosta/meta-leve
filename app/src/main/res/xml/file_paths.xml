<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Imagens, textos e PDFs gerados para compartilhar. -->
    <cache-path name="share" path="share/" />
    <!-- Foto temporária do "Prato por foto" (apagada ao sair da tela). -->
    <cache-path name="prato" path="prato/" />
    <!-- Backup montado para enviar por e-mail. -->
    <cache-path name="backup" path="backup/" />
    <!-- Anexos da seção Saúde (para abrir ou enviar o arquivo original). -->
    <files-path name="anexos" path="anexos/" />
</paths>
