<?xml version="1.0" encoding="utf-8"?>
<!-- Backup automático do Android (Android 11 ou mais antigo): leva tudo, menos a chave da IA
     (criptografada com uma chave do Keystore presa a este aparelho). -->
<full-backup-content>
    <exclude domain="sharedpref" path="minha_ia.xml" />
</full-backup-content>
