<?xml version="1.0" encoding="utf-8"?>
<!-- Backup automático do Android (Android 12 ou mais novo): leva tudo, menos a chave da IA.
     A chave em minha_ia.xml é criptografada com uma chave do Keystore presa a este aparelho
     e não pode ser aberta em outro celular. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="minha_ia.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="minha_ia.xml" />
    </device-transfer>
</data-extraction-rules>
